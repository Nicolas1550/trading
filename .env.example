# Env vars on the server. Don't prefix private keys with NEXT_PUBLIC_.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
TWELVE_DATA_API_KEY="YOUR_PRIVATE_TWELVE_DATA_KEY"
# Optional: QUANTUM AI Copilot. Market Insights works without it.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
